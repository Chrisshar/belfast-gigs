---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { WEEKDAYS } from '../content.config';

const residencies = await getCollection('residencies');
const nights = (
  await Promise.all(
    residencies.map(async (r) => {
      const venue = await getEntry(r.data.venue);
      return r.data.nights.map((night) => ({ ...night, venue: venue?.data.name ?? r.data.venue.id }));
    }),
  )
).flat();
const groups = [
  ...WEEKDAYS.map((day) => ({ key: day as string, label: day[0].toUpperCase() + day.slice(1), nights: nights.filter((n) => n.weekday === day) })),
  { key: 'unknown', label: 'Day to be confirmed', nights: nights.filter((n) => !n.weekday) },
].filter((g) => g.nights.length > 0);
---

<Base title="Regular nights" description="Weekly sessions, open mics and residencies around Belfast.">
  <div class="intro">
    <h1>Regular nights</h1>
    <p>Weekly sessions, open mics and residencies. They change without much notice, so check with the venue before you go.</p>
  </div>
  {
    groups.map((g) => (
      <section data-weekday={g.key}>
        <div class="sec"><h2>{g.label}</h2></div>
        <div class="regulars">
          {g.nights.map((n) => (
            <div class="regular">
              <Art genres={n.genres} />
              <div>
                <h3>{n.title}</h3>
                <div class="meta">{n.venue}{n.start_time && ` · ${n.start_time}`}{n.notes && ` · ${n.notes}`}</div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</Base>

<script>
  // Mark tonight's nights, in Belfast time.
  const today = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'long' }).format(new Date()).toLowerCase();
  const section = document.querySelector<HTMLElement>(`[data-weekday="${today}"]`);
  if (section) {
    section.querySelectorAll('.regular').forEach((el) => el.classList.add('today'));
    const h = section.querySelector('h2');
    if (h) h.textContent += ' (tonight)';
  }
</script>
