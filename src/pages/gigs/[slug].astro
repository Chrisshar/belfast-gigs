---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import { formatDate } from '../../lib/dates';
import { STATUS_LABELS, formatPrice, toViews } from '../../lib/gigs';
import { venueEventUrl } from '../../lib/links';

export async function getStaticPaths() {
  const views = await toViews(await getCollection('gigs'));
  return views.map((view) => ({ params: { slug: view.slug }, props: { view } }));
}

const { view } = Astro.props;
const d = view.gig.data;
const venue = view.venue?.data;
const { Content } = await render(view.gig);
// The venue file's body is a short blurb about the venue; new venues have none until someone writes one.
const VenueAbout = view.venue?.body?.trim() ? (await render(view.venue)).Content : null;
const price = formatPrice(d);
const longDate = formatDate(d.date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const dateRange = d.end_date ? `${longDate} to ${formatDate(d.end_date, { weekday: 'long', day: 'numeric', month: 'long' })}` : longDate;
const address = [venue?.address, venue?.postcode].filter(Boolean).join(', ');
const mapQuery = encodeURIComponent([view.venueName, address || 'Belfast'].join(', '));
const tickets = d.tickets;
// Until gig pages have their own blurb about the act, point to the venue's write-up.
const venuePage = venueEventUrl(d.sources, venue?.website);

// schema.org MusicEvent, so search engines can show the gig as an event.
const STATUS_SCHEMA: Record<string, string> = {
  on_sale: 'EventScheduled',
  sold_out: 'EventScheduled',
  cancelled: 'EventCancelled',
  postponed: 'EventPostponed',
  rescheduled: 'EventRescheduled',
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: d.title,
  startDate: d.start_time ? `${d.date}T${d.start_time}` : d.date,
  ...(d.end_date && { endDate: d.end_date }),
  ...(d.doors_time && { doorTime: `${d.date}T${d.doors_time}` }),
  eventStatus: `https://schema.org/${STATUS_SCHEMA[d.status]}`,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'MusicVenue',
    name: view.venueName,
    address: { '@type': 'PostalAddress', streetAddress: venue?.address, postalCode: venue?.postcode, addressLocality: 'Belfast', addressCountry: 'GB' },
  },
  performer: [d.headliner, ...d.support].map((name) => ({ '@type': 'MusicGroup', name })),
  ...(tickets[0] && {
    offers: {
      '@type': 'Offer',
      url: tickets[0].url,
      ...(d.price_min !== undefined && { price: d.price_min, priceCurrency: 'GBP' }),
      ...(d.free && { price: 0, priceCurrency: 'GBP' }),
      availability: d.status === 'sold_out' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    },
  }),
  url: new URL(`/gigs/${view.slug}/`, Astro.site).href,
};
const description = `${d.headliner}${d.support.length ? ` with ${d.support.join(', ')}` : ''} at ${view.venueName}, ${longDate}.`;
---

<Base title={`${d.headliner}, ${formatDate(d.date, { day: 'numeric', month: 'short' })}`} description={description} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <a class="back" href="/">← All gigs</a>
  <article class="detail">
    <Art genres={d.genres} shape="wide" />
    <div class="body">
      <div>
        <div class="when">{dateRange}</div>
        <h1>{d.headliner}</h1>
        {d.support.length > 0 && <p class="support">with {d.support.join(', ')}</p>}
        <p class="where">
          {view.venueName}{d.room && ` · ${d.room}`}{address && <>, {address}</>}
          <br /><a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} rel="noopener">Directions</a>
        </p>
        <div class="about"><Content /></div>
        {venuePage && <p class="more-info"><a href={venuePage} target="_blank" rel="noopener">More about this gig on {view.venueName}'s website<span class="visually-hidden"> (opens in a new tab)</span></a> ↗</p>}
        {
          VenueAbout && (
            <section class="venue-about" aria-labelledby="venue-about-h">
              <h2 id="venue-about-h">About {view.venueName}</h2>
              <VenueAbout />
            </section>
          )
        }
      </div>
      <div>
        <dl class="facts">
          {d.status !== 'on_sale' && <div><dt>Status</dt><dd class="status">{STATUS_LABELS[d.status]}</dd></div>}
          {d.doors_time && <div><dt>Doors</dt><dd>{d.doors_time}</dd></div>}
          <div><dt>Starts</dt><dd>{d.start_time ?? (d.doors_time ? 'After doors' : 'To be confirmed')}</dd></div>
          <div><dt>{d.free ? 'Entry' : 'Tickets from'}</dt><dd>{price ?? 'See ticket seller'}</dd></div>
          {d.age_restriction && <div><dt>Age</dt><dd>{d.age_restriction}</dd></div>}
          {d.genres.length > 0 && <div><dt>Genre</dt><dd>{d.genres.join(', ')}</dd></div>}
        </dl>
        <div class="actions">
          {
            tickets.map((t, i) => (
              <a class:list={['btn', { primary: i === 0 }]} href={t.url} rel="noopener">
                {d.status === 'sold_out' && i === 0 ? 'Check resale' : 'Tickets'} from {t.source}
              </a>
            ))
          }
          <a class:list={['btn', { primary: tickets.length === 0 }]} href={`/gigs/${view.slug}.ics`} download>Add to calendar</a>
        </div>
        <p class="note">Details can change. Check with the venue or ticket seller before you go.</p>
      </div>
    </div>
  </article>
</Base>
