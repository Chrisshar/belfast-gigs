---
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/jost/600.css';
import '../styles/global.css';
import { craneMark } from '../lib/art/logo';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}
const { title, description = 'Upcoming live music in Belfast, all in one place.', ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} · Belfast Gigs` : 'Belfast Gigs · Live music in Belfast';
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' || path.startsWith('/gigs/') : path.startsWith(href)) ? 'page' : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta property="og:site_name" content="Belfast Gigs" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><Fragment set:html={craneMark()} />Belfast Gigs</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/" aria-current={current('/')}>Gigs</a>
          <a href="/regulars/" aria-current={current('/regulars/')}>Regular nights</a>
        </nav>
        {/* Searches the homepage listing. Without JavaScript it's a plain GET to /?q=. On phones it
            folds behind an icon (src/scripts/search.ts). */}
        <form class="site-search" id="site-search" action="/#upcoming-h" method="get" role="search" aria-label="Search gigs">
          <label>
            <span class="visually-hidden">Search acts or venues</span>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="7" cy="7" r="4.75"/><path d="m10.5 10.5 4 4"/></g></svg>
            <input type="search" name="q" placeholder="Search acts or venues" autocomplete="off" enterkeyhint="search" />
            <button type="button" class="search-clear" aria-label="Clear search"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="m4 4 8 8m0-8-8 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
          </label>
          <button type="button" class="search-close" aria-label="Close search">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="m3.5 3.5 9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
        </form>
        <button type="button" class="search-open" aria-label="Search acts or venues" aria-controls="site-search" aria-expanded="false">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="7" cy="7" r="4.75"/><path d="m10.5 10.5 4 4"/></g></svg>
        </button>
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Gathered twice a day from venue websites and ticket sellers. Always check with the venue before you travel.</span>
        <span><a href="https://github.com/Chrisshar/belfast-gigs">About this site</a></span>
      </div>
    </footer>
    <script>
      import { initSearch } from '../scripts/search';
      initSearch();
    </script>
  </body>
</html>
