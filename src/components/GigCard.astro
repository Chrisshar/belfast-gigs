---
import Art from './Art.astro';
import { dayParts } from '../lib/dates';
import { STATUS_LABELS, filterAttrs, type GigView } from '../lib/gigs';

interface Props {
  view: GigView;
}
const { view } = Astro.props;
const d = view.gig.data;
const p = dayParts(d.date);
const time = d.start_time ?? d.doors_time;
---

<a class="card" href={`/gigs/${view.slug}/`} {...filterAttrs(view)}>
  <Art genres={d.genres} shape="banner" />
  <div class="body">
    <div class="when">{p.dow} {p.day} {p.mon}{p.otherYear}{time && `, ${time}`}</div>
    <h3>{d.headliner}</h3>
    <div class="venue">{view.venueName}{d.status !== 'on_sale' && <span class="status inline">{STATUS_LABELS[d.status]}</span>}</div>
    {d.genres[0] && <div class="tag">{d.genres[0]}</div>}
  </div>
</a>
