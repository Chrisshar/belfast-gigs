---
import { instrumentFor, instrumentSvg } from '../lib/art/instruments';

interface Props {
  /** Genres with gigs listed, in filter-chip order. */
  genres: readonly string[];
  /** Whether any listed gig has no genre, and so shows the speaker. */
  other: boolean;
}
const { genres, other } = Astro.props;
const entries = [
  ...genres.map((g) => ({ label: g, svg: instrumentSvg(instrumentFor([g])) })),
  ...(other ? [{ label: 'Other / no genre', svg: instrumentSvg('default') }] : []),
];
---

{/* Always open on wide screens; a closed accordion on phones. Without JavaScript it stays open. */}
<details class="key" id="key" open>
  <summary>
    <h2>Key</h2>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </summary>
  <ul>
    {entries.map((e) => <li><span class="art" set:html={e.svg} />{e.label}</li>)}
  </ul>
</details>

<script is:inline>
  // Close it before it paints on phones, so it doesn't flash open.
  try {
    if (matchMedia('(max-width: 640px)').matches) document.getElementById('key').open = false;
  } catch (e) {}
</script>

<script>
  const key = document.querySelector<HTMLDetailsElement>('#key');
  const phone = matchMedia('(max-width: 640px)');
  const summary = key?.querySelector('summary');
  if (key && summary) {
    // Wide screens: always open, and the caption is just a caption, out of the tab order.
    summary.addEventListener('click', (event) => {
      if (!phone.matches && key.open) event.preventDefault();
    });
    const fit = (): void => {
      key.open = !phone.matches;
      summary.tabIndex = phone.matches ? 0 : -1;
    };
    summary.tabIndex = phone.matches ? 0 : -1;
    phone.addEventListener('change', fit);
  }
</script>
